      "source": [
        "class Human:\n",
        "  def __init__(self, name, age):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "\n",
        "  def printinfo(self):\n",
        "    return f\"{self.name} {self.age}\"\n",
        "\n",
        "human = Human(\"サムライ太郎\", 20)\n",
        "\n",
        "print(human.printinfo())"
      ],

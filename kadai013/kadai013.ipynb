        "def tax_inclusive_price(price,tax_rate):\n",
        "  tax_inclusive_price =price * tax_rate * 0.1\n",
        "  print(f\"{price}円に消費税{tax_rate}％を加算した価格は{tax_inclusive_price}円です\")\n",
